# ─── TeamHub Meeting configuration ─────────────────────────────────────────
# Leave VITE_SUPABASE_URL empty to run in DEMO MODE (local data, no setup).

# Supabase project (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Use private (RLS-protected) Realtime channels for meetings. Requires
# supabase/migrations/0003_functions.sql (realtime.messages policies).
VITE_REALTIME_PRIVATE=true

# Optional TURN server for restrictive networks (STUN is used by default)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# AI meeting assistant: "mock" (default) or "edge" (Supabase Edge Function meeting-insights)
VITE_AI_PROVIDER=mock

# Only for scripts/seed-supabase.ts — NEVER expose in the browser
SUPABASE_SERVICE_ROLE_KEY=
